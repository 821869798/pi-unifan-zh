{
  "name": "@unifan/pi-unifan-zh",
  "version": "1.0.34",
  "description": "Pi Coding Agent 中文扩展全家桶与独立插件集",
  "type": "module",
  "main": "extensions/sessions/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/821869798/pi-unifan-zh.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:commit": "node --test extensions/commit/tests/commit.test.mjs",
    "test:review": "node --test extensions/review/tests/orchestration.test.mjs",
    "test:workflow": "node --test extensions/workflow/tests/workflow.test.mjs",
    "test": "node --test extensions/commit/tests/commit.test.mjs extensions/review/tests/orchestration.test.mjs extensions/workflow/tests/workflow.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/sessions/index.ts",
      "./extensions/review/index.ts",
      "./extensions/commit/index.ts",
      "./extensions/workflow/index.ts"
    ],
    "subagents": {
      "agents": [
        "./extensions/review/agents"
      ]
    },
    "skills": [
      "./extensions/workflow/skills",
      "./skills"
    ]
  },
  "keywords": [
    "pi-extension",
    "pi-coding-agent",
    "chinese",
    "sessions",
    "review",
    "commit",
    "workflow",
    "compound-engineering",
    "tui"
  ],
  "author": "unifan",
  "license": "MIT",
  "peerDependencies": {
    "@juicesharp/rpiv-ask-user-question": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@juicesharp/rpiv-ask-user-question": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
